{
  "name": "liker-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api": "npm run dev -w apps/api",
    "admin": "npm run dev -w apps/admin",
    "build": "npm run build -w apps/api && npm run build -w apps/admin",
    "api:build": "npm run build -w apps/api",
    "admin:build": "npm run build -w apps/admin"
  },
  "engines": {
    "node": ">=18"
  }
}
