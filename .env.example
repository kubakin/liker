# Порт API (по умолчанию 3001)
PORT=3001

# PostgreSQL (обязательно для API)
DATABASE_URL=postgresql://user:password@localhost:5432/liker
# Если пароль содержит @, #, % — задайте его отдельно (переопределит пароль из URL):
# DATABASE_PASSWORD=your_password

# Синхронизация схемы (true в dev, отключите в production)
# NODE_ENV=production

# Логирование SQL (опционально)
# TYPEORM_LOGGING=true

# OAuth ВКонтакте (для кнопки «Получить токен ВКонтакте» в админке)
# Создайте приложение на https://dev.vk.com/apps?act=manage , укажите Redirect URI: http://localhost:3002/api/auth/vk/callback
VK_APP_ID=12345678
VK_APP_SECRET=secret
VK_REDIRECT_URI=http://localhost:3002/api/auth/vk/callback
# Куда редиректить после успешного получения токена (URL админки):
VK_FRONTEND_REDIRECT_URI=http://localhost:3000
# Права доступа (по умолчанию 10240 = offline+wall). При ошибке "invalid scope" задайте: VK_OAUTH_SCOPE=10240
# VK_OAUTH_SCOPE=10240

# VK ID (кнопка «Войти через VK ID») — приложение нужно создать отдельно от dev.vk.com:
# 1. Кабинет: https://id.vk.ru/about/business/go/ → Мои приложения → Добавить приложение
# 2. Платформа: Web. Укажите Базовый домен и Доверенный redirect URL (например https://your-domain/auth/vkid-callback)
# 3. В настройках приложения: Авторизация → при необходимости включите «Дополнительные способы входа»
# 4. ID приложения из кабинета VK ID укажите здесь (это не тот же ID, что в dev.vk.com)
# VK_ID_APP_ID=12345678
