# Пример для деплоя через Docker.
# Скопируйте в .env и подставьте свои значения.
# Переменные из .env подхватятся контейнером api (env_file в docker-compose).

# PORT=3002
# DATABASE_URL переопределяется в docker-compose (postgres в сети).
# Для внешней БД задайте: DATABASE_URL=postgresql://user:pass@host:5432/liker

# VK (OAuth и/или VK ID)
# VK_APP_ID=...
# VK_APP_SECRET=...
# VK_REDIRECT_URI=https://your-domain/api/auth/vk/callback
# VK_FRONTEND_REDIRECT_URI=https://your-domain
# VK_ID_APP_ID=...
